generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id               String       @id @default(uuid())
  studentUniqueId  String?      @unique 
  email            String       @unique
  password         String
  fullName         String
  phoneNumber      String       @unique
  country          String?
  dob              String?
  gender           String?
  islamicKnowledge String?
  arabicLevel      String?
  role             Role         @default(STUDENT)
  mustResetPass    Boolean      @default(true)
  isBlocked        Boolean      @default(false)
  enrollments      Enrollment[]
  dailyMarks       DailyMark[]  @relation("StudentMarks")
  markedMarks      DailyMark[]  @relation("TeacherMarks") 
  examMarks        ExamMark[]
  examAttempts     ExamAttempt[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Program {
  id               String        @id @default(uuid())
  slug             String        @unique
  titleEn          String
  titleAr          String?
  maxDailyMark     Int           @default(100)
  maxExamMark      Int           @default(15)   // Fully dynamic exam ceiling
  isRegOpen        Boolean       @default(true)
  isPaid           Boolean       @default(false)
  enrollments      Enrollment[]
  dailyMarks       DailyMark[]
  examMarks        ExamMark[]                   // New relation back to exams
  exams            Exam[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Enrollment {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId      String
  program        Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  approvalStatus ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, programId])
}

model DailyMark {
  id          String   @id @default(uuid())
  
  studentId   String
  student     User     @relation("StudentMarks", fields: [studentId], references: [id], onDelete: Cascade)
  
  teacherId   String?
  teacher     User?    @relation("TeacherMarks", fields: [teacherId], references: [id], onDelete: SetNull)

  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  
  dayNumber   Int      @default(1)
  score       Float
  notes       String?
  date        DateTime @default(now())

  @@unique([studentId, programId, dayNumber]) 
}

model ExamMark {
  id        String   @id @default(uuid())
  
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  
  score     Float?
  date      DateTime @default(now())

  @@unique([studentId, programId]) // Ensures one exam score per student per program
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  TIMED_OUT
}

model Exam {
  id              String         @id @default(uuid())
  programId       String
  program         Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  
  title           String
  description     String?
  instructions    String?
  
  startsAt        DateTime       // Date & time the exam opens
  endsAt          DateTime       // Date & time the exam closes
  durationMinutes Int            // Student countdown timer in minutes
  
  totalMarks      Float          @default(60.0)
  markPerQuestion Float          @default(2.0)
  
  status          ExamStatus     @default(DRAFT)
  
  questions       ExamQuestion[]
  attempts        ExamAttempt[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([programId])
}

model ExamQuestion {
  id            String       @id @default(uuid())
  examId        String
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  
  order         Int          // 1, 2, 3...
  questionText  String       // Arabic / English text
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String       // "A" | "B" | "C" | "D"
  marks         Float        @default(2.0)
  
  answers       ExamAnswer[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([examId, order])
}

model ExamAttempt {
  id                String        @id @default(uuid())
  examId            String
  exam              Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId         String
  student           User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  status            AttemptStatus @default(IN_PROGRESS)
  startedAt         DateTime      @default(now())
  submittedAt       DateTime?
  
  scoreObtained     Float?
  grade             String?       // "A", "B", "C", "D", "F"
  
  tabSwitches       Int           @default(0)
  
  answers           ExamAnswer[]
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([studentId, examId])
  @@index([examId, status])
}

model ExamAnswer {
  id             String       @id @default(uuid())
  attemptId      String
  attempt        ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  selectedOption String?      // "A" | "B" | "C" | "D"
  isCorrect      Boolean?
  marksAwarded   Float?       @default(0.0)

  @@unique([attemptId, questionId])
}
