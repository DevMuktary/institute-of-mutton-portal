generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id               String       @id @default(uuid())
  studentUniqueId  String?      @unique // Brought over from your old 'students' table
  email            String       @unique
  password         String
  fullName         String
  phoneNumber      String       @unique
  country          String?
  dob              String?
  gender           String?
  islamicKnowledge String?
  arabicLevel      String?
  role             Role         @default(STUDENT)
  mustResetPass    Boolean      @default(true)
  isBlocked        Boolean      @default(false)
  enrollments      Enrollment[]
  dailyMarks       DailyMark[]  @relation("StudentMarks")
  markedMarks      DailyMark[]  @relation("TeacherMarks") // Tracks which teacher gave the mark
  examMarks        ExamMark[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Program {
  id               String        @id @default(uuid())
  slug             String        @unique
  titleEn          String
  titleAr          String?
  maxDailyMark     Int           @default(100)
  isRegOpen        Boolean       @default(true)
  isPaid           Boolean       @default(false)
  enrollments      Enrollment[]
  dailyMarks       DailyMark[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Enrollment {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId      String
  program        Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  approvalStatus ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, programId])
}

model DailyMark {
  id          String   @id @default(uuid())
  
  studentId   String
  student     User     @relation("StudentMarks", fields: [studentId], references: [id], onDelete: Cascade)
  
  teacherId   String?
  teacher     User?    @relation("TeacherMarks", fields: [teacherId], references: [id], onDelete: SetNull)

  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  
  dayNumber   Int      // Replaces dayLabel to allow chronological spreadsheet sorting
  score       Float
  notes       String?  // Optional teacher feedback
  
  date        DateTime @default(now())

  @@unique([studentId, programId, dayNumber]) // Prevents a student from having two scores for "Day 1"
}

model ExamMark {
  id        String   @id @default(uuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score     Float?
  date      DateTime @default(now())
}